<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Open link looks up the site's app or a browser to hand the link to. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".UnfurlitApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unfurlit"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- YouTube watch, Shorts, and live links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:path="/watch" />
                <data android:pathPrefix="/shorts/" />
                <data android:pathPrefix="/live/" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>

            <!-- Reddit posts, comments, galleries, and short links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="reddit.com" />
                <data android:host="www.reddit.com" />
                <data android:host="old.reddit.com" />
                <data android:pathPattern="/r/.*/comments/.*" />
                <data android:pathPrefix="/comments/" />
                <data android:pathPrefix="/gallery/" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="redd.it" />
            </intent-filter>

            <!-- X and Twitter status links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="x.com" />
                <data android:host="www.x.com" />
                <data android:host="twitter.com" />
                <data android:host="www.twitter.com" />
                <data android:host="mobile.twitter.com" />
                <data android:pathPattern="/.*/status/.*" />
                <data android:pathPrefix="/i/status/" />
            </intent-filter>

            <!-- Instagram posts, reels, share links and legacy IGTV links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="instagram.com" />
                <data android:host="www.instagram.com" />
                <data android:pathPrefix="/p/" />
                <data android:pathPrefix="/reel/" />
                <data android:pathPrefix="/tv/" />
                <!-- "..*" needs an ID, so the Reels tab itself still opens in the browser. -->
                <data android:pathPattern="/reels/..*" />
                <data android:pathPattern="/share/p/..*" />
                <data android:pathPattern="/share/reel/..*" />
                <data android:pathPattern="/.*/reel/..*" />
            </intent-filter>

            <!-- TikTok videos and redirect links. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="tiktok.com" />
                <data android:host="www.tiktok.com" />
                <data android:host="m.tiktok.com" />
                <data android:pathPattern="/.*/video/.*" />
                <data android:pathPattern="/.*/photo/.*" />
                <data android:pathPrefix="/t/" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="vm.tiktok.com" />
                <data android:host="vt.tiktok.com" />
            </intent-filter>

            <!-- Vimeo videos: page paths start with the numeric video ID. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="vimeo.com" />
                <data android:host="www.vimeo.com" />
                <data android:pathPattern="/1.*" />
                <data android:pathPattern="/2.*" />
                <data android:pathPattern="/3.*" />
                <data android:pathPattern="/4.*" />
                <data android:pathPattern="/5.*" />
                <data android:pathPattern="/6.*" />
                <data android:pathPattern="/7.*" />
                <data android:pathPattern="/8.*" />
                <data android:pathPattern="/9.*" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="player.vimeo.com" />
                <data android:pathPrefix="/video/" />
            </intent-filter>

            <!-- Tumblr posts on blog subdomains and on www.tumblr.com/<blog>/<post ID>. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*.tumblr.com" />
                <data android:pathPrefix="/post/" />
            </intent-filter>
            <!--
                A post ID of at least ten characters after one path segment; a pattern ".*" stops at
                the next "/", so this skips tag and search pages such as /tagged/2024.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="tumblr.com" />
                <data android:host="www.tumblr.com" />
                <data android:pathPattern="/.*/1..........*" />
                <data android:pathPattern="/.*/2..........*" />
                <data android:pathPattern="/.*/3..........*" />
                <data android:pathPattern="/.*/4..........*" />
                <data android:pathPattern="/.*/5..........*" />
                <data android:pathPattern="/.*/6..........*" />
                <data android:pathPattern="/.*/7..........*" />
                <data android:pathPattern="/.*/8..........*" />
                <data android:pathPattern="/.*/9..........*" />
            </intent-filter>

            <!-- Pixiv artworks. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="pixiv.net" />
                <data android:host="www.pixiv.net" />
                <data android:pathPattern="/artworks/..*" />
                <data android:pathPattern="/en/artworks/..*" />
            </intent-filter>

            <!-- Bluesky posts. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="bsky.app" />
                <data android:pathPattern="/profile/.*/post/..*" />
            </intent-filter>

            <!-- Bandcamp tracks. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*.bandcamp.com" />
                <data android:pathPattern="/track/..*" />
            </intent-filter>
        </activity>

        <!-- Background playback; exported so the system can show and control the session. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
